# Copy to .streamlit/secrets.toml (gitignored — never commit real values there) and fill
# in real credentials. Same three blocks get pasted into Streamlit Cloud's Secrets
# manager verbatim when deploying.

[snowflake]
account = "your_account_identifier"
user = "your_service_account_user"
role = "your_role"
warehouse = "your_warehouse"
database = "JSA"
schema = "RISK_ANALYZER"
# Key-pair auth, not a password — provide exactly ONE of these two:
private_key_path = "/path/to/rsa_key.p8"   # local dev only — a path on disk
# private_key_pem = """                    # required on Streamlit Cloud (no persistent
# -----BEGIN PRIVATE KEY-----              # filesystem to point a path at) — paste the
# ...                                       # full contents of rsa_key.p8 here, unencrypted,
# -----END PRIVATE KEY-----                 # inside a TOML triple-quoted string like this.
# """

[massive]
api_key = "..."
base_url = "https://api.massive.com"

# CME DataMine end-of-day files -- the only CME product JSA is licensed for (the Options
# Analytics Greeks REST API 403s permanently for this account, so it's not used at all;
# don't add a [cme_greeks] block back). Needs an API ID whose Customer Center Role is
# "DataMine API (OAuth)". The ID is case-sensitive.
[cme_datamine]
api_id = "api_jpsioptions"
password = "..."
# base_url = "https://datamine.new.cmegroup.com/cme/api/v2"
# token_url = "https://auth.cmegroup.com/as/token.oauth2"
